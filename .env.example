# Copy this file to server/.env and fill in your key. Never commit the real .env.

# Required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the Live model. Left blank, the app uses the default in
# server/app/gemini/client.py.
GEMINI_MODEL=gemini-live-2.5-flash-preview